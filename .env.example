# ==========================================
# МУЛЬТИАГЕНТНАЯ СИСТЕМА ЯНДЕКС ДИРЕКТ + ML
# ==========================================

# --- Яндекс Директ API ---
# Получите токен на https://oauth.yandex.ru/
YANDEX_DIRECT_TOKEN=your_oauth_token_here

# Client Login (логин клиента, если работаете через агентство)
# Оставьте пустым, если работаете напрямую
YANDEX_CLIENT_LOGIN=

# Режим работы: sandbox (тестовый) или production (боевой)
YANDEX_API_MODE=sandbox

# --- OpenRouter API (Claude Sonnet 4.5) ---
# Получите ключ на https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Модель Claude (по умолчанию Claude Sonnet 4.5)
CLAUDE_MODEL=anthropic/claude-sonnet-4

# --- Настройки приложения ---
# Директория для данных
DATA_DIR=./data

# Логирование: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- База данных (опционально) ---
# DB_PASSWORD=your_secure_password
